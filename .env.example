# Copy to .env and fill in. Source it before running atmos:  set -a; . ./.env; set +a
#
# --- Proxmox (bpg/proxmox provider) ---
# API endpoint of your Proxmox VE host/cluster.
export PROXMOX_VE_ENDPOINT="https://proxmox.example.com:8006/"
# Recommended: API token in the form USER@REALM!TOKENID=UUID
export PROXMOX_VE_API_TOKEN="root@pam!atmos=00000000-0000-0000-0000-000000000000"
# Alternatively use username/password instead of an API token:
# export PROXMOX_VE_USERNAME="root@pam"
# export PROXMOX_VE_PASSWORD="changeme"
# Allow self-signed certs on the Proxmox API (set to true for typical home labs).
export PROXMOX_VE_INSECURE="true"
# SSH connection the provider uses for file uploads / agent operations.
export PROXMOX_VE_SSH_USERNAME="root"

# --- Proxmox for cluster-B ("edge" stage) — STANDALONE host pve2 at 10.10.1.82 ---
# Only needed to provision the second cluster (atmos ... -s edge). The edge stack
# (stacks/catalog/cluster-edge.yaml) points the proxmox-vms component's env at
# these, so `-s prod` keeps using the PROXMOX_VE_* endpoint/token above.
export PROXMOX_VE_B_ENDPOINT="https://10.10.1.82:8006/"
export PROXMOX_VE_B_API_TOKEN="root@pam!atmos=00000000-0000-0000-0000-000000000000"

# --- Ansible ---
# Private key matching the public key injected into the VMs via cloud-init.
export ANSIBLE_PRIVATE_KEY_FILE="${HOME}/.ssh/id_ed25519"
export ANSIBLE_HOST_KEY_CHECKING="false"

# --- Ansible Vault (for the k3s join token) ---
# Path to a file containing the vault password used to decrypt group_vars secrets.
export ANSIBLE_VAULT_PASSWORD_FILE="${HOME}/.config/atmos-k3s/vault-pass"

# --- Kargo (Phase 4: promote the vLLM pipeline from staging cluster-A to prod
#     cluster-B). Only needed to install Kargo + run promotions on cluster-A. ---
# Admin login for the Kargo API/UI. The password hash is bcrypt; generate both:
#   KARGO_ADMIN_PASSWORD_HASH=$(htpasswd -bnBC 10 "" 'admin' | tr -d ':\n' | sed 's/^\$2y/\$2a/')
#   KARGO_ADMIN_TOKEN_SIGNING_KEY=$(openssl rand -base64 48 | tr -d "=+/" | cut -c1-40)
# (single-quote the hash so the shell doesn't eat the `$` segments)
export KARGO_ADMIN_PASSWORD_HASH='$2a$10$replace-with-a-real-bcrypt-hash'
export KARGO_ADMIN_TOKEN_SIGNING_KEY="replace-with-a-40char-random-string"
# GitHub PAT with "Contents: Read and write" on THIS repo. Kargo pushes a small
# promotion commit that pins each stage's Argo CD app targetRevision to the
# verified Freight commit (fine-grained token recommended).
export KARGO_GIT_USERNAME="rykelley"
export KARGO_GIT_PAT="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"
# Optional: overrides the repo Kargo watches/writes (defaults to the URL in
# gitops/root-app.yaml).
# export KARGO_GITOPS_REPO_URL="https://github.com/rykelley/atmos-proxmox-k8s.git"
