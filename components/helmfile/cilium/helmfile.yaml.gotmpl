# Cilium CNI for k3s with full kube-proxy replacement.
# Atmos passes stack `vars` as Helmfile state values (.Values.*) and sets
# KUBECONFIG via the component `env`. Use `dig` for optional keys so stacks
# that omit a var (e.g. edge) do not fail template parse.

repositories:
  - name: cilium
    url: https://helm.cilium.io/

{{- $enableGateway := dig "enable_gateway_api" true .Values }}
{{- $enableIngress := dig "enable_ingress_controller" false .Values }}
{{- $enableL2 := dig "enable_l2_announcements" true .Values }}

releases:
  - name: cilium
    namespace: kube-system
    chart: cilium/cilium
    version: {{ dig "cilium_chart_version" "1.16.5" .Values | quote }}
    wait: true
    waitForJobs: true
    timeout: 600
    {{- if $enableGateway }}
    # Gateway API CRDs must exist before the cilium agent enables the Gateway
    # API feature. Applied idempotently before each cilium sync.
    hooks:
      - events: ["presync"]
        showlogs: true
        command: kubectl
        args:
          - apply
          - -f
          - {{ dig "gateway_api_crds_url" "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.0/experimental-install.yaml" .Values | quote }}
    {{- end }}
    values:
      - kubeProxyReplacement: true
        k8sServiceHost: {{ dig "control_plane_endpoint" "10.10.1.31" .Values | quote }}
        k8sServicePort: {{ dig "api_port" 6443 .Values }}

        # k3s allocates per-node podCIDRs from --cluster-cidr, so use the
        # Kubernetes IPAM mode which honors those allocations.
        ipam:
          mode: kubernetes

        # Native routing is not assumed across the L2 segment; use tunneling
        # (VXLAN) which works on a flat 10.10.1.0/24 bridge.
        routingMode: tunnel
        tunnelProtocol: vxlan

        operator:
          replicas: 2

        # Socket-based load balancing complements the kube-proxy replacement.
        socketLB:
          enabled: true

        # k3s works with Cilium's default CNI paths (/opt/cni/bin,
        # /etc/cni/net.d) once flannel is disabled - do NOT override them.

        # Required so socket-LB / kube-proxy replacement works under k3s.
        cgroup:
          autoMount:
            enabled: false
          hostRoot: /sys/fs/cgroup

        bpf:
          masquerade: true

        hubble:
          enabled: true
          relay:
            enabled: true
          ui:
            enabled: true

        # --- Gateway API (north-south ingress for the filament app) ---
        gatewayAPI:
          enabled: {{ $enableGateway }}

        # --- Ingress controller (standard networking.k8s.io/v1 Ingress) ---
        # Cilium can serve BOTH Gateway API (above) and classic Ingress via the
        # same Envoy L7 proxy. The cluster's UIs use Gateway API; this makes plain
        # Ingress available too. `shared` mode routes every Ingress through one
        # `cilium-ingress` LoadBalancer Service (kube-system) pinned to a reserved
        # LAN IP, so future apps just add an Ingress (host/path) with no new IP.
        ingressController:
          enabled: {{ $enableIngress }}
          # Handle Ingress resources that don't set an ingressClassName.
          default: true
          loadbalancerMode: shared
          # Plain HTTP on the trusted LAN; don't 308-redirect to HTTPS.
          enforceHttps: false
          service:
            # Cilium LB-IPAM assigns this specific address to the shared
            # cilium-ingress Service (pool/L2 policy in the monitoring-extras
            # chart: apps/monitoring-extras/chart/templates/loadbalancer.yaml).
            annotations:
              io.cilium/lb-ipam-ips: {{ dig "ingress_lb_ip" "10.10.1.248" .Values | quote }}

        # --- L2 LoadBalancer for bare-metal (no servicelb) ---
        # LB IPs are allocated by CiliumLoadBalancerIPPool and advertised via
        # CiliumL2AnnouncementPolicy (both shipped with the filament-app chart).
        l2announcements:
          enabled: {{ $enableL2 }}
        externalIPs:
          enabled: true
        k8sClientRateLimit:
          qps: {{ dig "k8s_client_qps" 15 .Values }}
          burst: {{ dig "k8s_client_burst" 20 .Values }}
