# cert-manager — a hard prerequisite for Kargo (Phase 4).
#
# Kargo's API server defaults to issuing itself a self-signed TLS cert via a
# cert-manager Issuer, and the chart's install-time checks expect the
# cert-manager CRDs to be present. We install it on cluster-A (the hub) only;
# cluster-B never runs Kargo.
#
# `crds.enabled: true` installs the CRDs with the chart (the modern replacement
# for the old `installCRDs` flag). Atmos passes stack `vars` as .Values.*.

repositories:
  - name: jetstack
    url: https://charts.jetstack.io

releases:
  - name: cert-manager
    namespace: {{ .Values.cert_manager_namespace | default "cert-manager" }}
    chart: jetstack/cert-manager
    version: {{ .Values.cert_manager_chart_version | default "v1.16.2" | quote }}
    createNamespace: true
    wait: true
    timeout: 600
    values:
      - crds:
          enabled: true
        # Modest footprint for a single-user learning cluster.
        replicaCount: 1
        webhook:
          replicaCount: 1
        cainjector:
          replicaCount: 1
